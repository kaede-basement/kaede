{
  "name": "kaede",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:hmr": "NODE_ENV=development tauri build --config src-tauri/tauri.hmr.conf.json",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview:frontend": "vite preview",
    "test": "bun test --preload ./scripts/setup-tests.ts src",
    "bench": "bun scripts/run-bench.ts",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "generate:validators": "bun scripts/compile-typebox-schemas.ts",
    "generate:bundle-analysis": "vite build --sourcemap && bunx source-map-explorer 'dist/assets/*.js' --html bundle-analysis.html --no-border-checks",
    "generate:types": "dts-bundle-generator ./src/declarations.ts -o ./types/kaede-lib.d.ts --project tsconfig.types.json --inline-declare-global"
  },
  "dependencies": {
    "@daidr/minecraft-skin-renderer": "^0.3.3",
    "@fabianlars/tauri-plugin-oauth": "^2.1.0",
    "@tanstack/vue-query": "^5.106.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-upload": "^2.5.0",
    "@vueuse/core": "^15.0.0",
    "ark-of-atrahasis": "^0.3.1",
    "dompurify": "^3.4.17",
    "m3ripple-vue": "^0.1.0",
    "marked": "^18.1.3",
    "prism-code-editor": "^5.4.0",
    "serialize-javascript": "^7.1.4",
    "ses": "^1.14.0",
    "typebox": "^1.4.4",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.34.0",
    "@iconify-json/lucide": "^1.2.70",
    "@stylistic/eslint-plugin": "^5.2.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/serialize-javascript": "^5.0.4",
    "@ungap/structured-clone": "^1.4.0",
    "@unocss/eslint-config": "^66.4.2",
    "@unocss/reset": "^66.12.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue-require-id/eslint-plugin": "^1.0.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "ajv": "^8.18.0",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.34.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "mitata": "^1.0.34",
    "typescript": "~5.8.3",
    "unocss": "^66.12.0",
    "vite": "^8.3.6",
    "vite-plugin-eslint2": "^5.0.4",
    "vue-tsc": "^2.2.12"
  }
}
