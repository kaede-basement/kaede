{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Default: true. Conflicts with packages that use typescript enums if true
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /*
     * Handle '@/...' imports.
     *
     * Since we include 'scripts/*.ts' in this config, 'vue-tsc -b' goes through
     * the referenced imports in those script files, finds '@/lib/schemas/types/accounts',
     * and reports the imports as errors, because it cannot recognize path aliases.
     *
     * UPD: ok we do not anymore, but let this stay
     */
    "paths": {
      "@/*": ["./src/*"]
    },

    "types": ["bun"]
  },
  "include": ["vite.config.ts"]
}
