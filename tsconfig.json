{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    /*
     * 'tsc' resolves '@/...' through the referenced configs, but 'bun test'
     * only reads 'tsconfig.json' and does not follow 'references',
     * so we duplicate paths here for the Bun runtime
     */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
